-- Type name conflict exhaustiveness test.
--
-- shadml uses a unified type namespace: data types, traits, type aliases,
-- builtin types, and bitfields all share the same name space. Two type-level
-- declarations with the same name are a compiler error.
--
-- However, constructors and value bindings live in a separate namespace,
-- so a constructor CAN share a name with its type (newtype pattern),
-- and a value binding CAN share a name with a record field, etc.
--
-- This file exercises every scenario to document how the compiler
-- handles them.

-- ============================================================================
-- 1. Associated type sharing a name with a data type
--    `Output` is both an associated type of Add (from prelude) and a data type.
--    Associated types are scoped to their trait, so they don't conflict
--    with top-level type names.

data Output = Output { tag : I32 }

-- Uses the prelude's Add trait and its builtin impl (no need to redeclare)
addResult : F32
addResult = 1.0 + 2.0

-- ============================================================================
-- 2. Multiple traits with the same associated type name
--    `Output` is declared in both Add and Mul (from prelude) without conflict.
--    Associated types are scoped to their trait.

-- Uses the prelude's Mul trait and its builtin impl
mulResult : F32
mulResult = 2.0 * 3.0

-- ============================================================================
-- 3. Constructor with the same name as its type (newtype pattern)
--    Very common in ML-family languages. Constructors are in the value
--    namespace, separate from the type namespace.

data Velocity = Velocity (Vec<3, F32>)

velocityResult : Velocity
velocityResult = Velocity [1.0, 0.0, 0.0]

-- ============================================================================
-- 4. Record field sharing a name with a top-level binding
--    Record fields and value bindings are in different scopes.

data Params = Params { scale : F32, offset : F32 }

offset : F32
offset = 0.5

paramsResult : Params
paramsResult = Params { scale = 2.0, offset = offset }

-- ============================================================================
-- 5. Trait with a method that has the same name as a data field
--    Method names and field names are in different namespaces.
--    NOTE: When a trait method and a field share a name, use field
--    access syntax (dot) which unambiguously selects the field.

data Lens = Lens { brightness : F32, contrast : F32 }

trait HasBrightness a where
  getBrightness : a -> F32

impl HasBrightness Lens where
  getBrightness l = l.brightness

brightnessResult : F32
brightnessResult = getBrightness (Lens { brightness = 0.8, contrast = 0.5 })

-- ============================================================================
-- 6. Using associated types in constrained function signatures
--    The return type uses the trait's associated type Output.

addThree : F32 -> F32 -> F32 -> F32
addThree x y z = (x + y) + z

addThreeResult : F32
addThreeResult = addThree 1.0 2.0 3.0

-- ============================================================================
-- 7. User-associated type named Output in a custom trait
--    `Output` is used by Add/Sub/Mul/etc. in the prelude.
--    A user trait can also declare `type Output` without conflict,
--    because associated types are scoped to their trait.

trait Scale a where
  type Output
  scaleTo : a -> F32 -> Output

data Weight = Weight { grams : F32 }

impl Scale Weight where
  type Output = Weight
  scaleTo w factor = Weight { grams = w.grams * factor }

scaledWeight : Weight
scaledWeight = scaleTo (Weight { grams = 100.0 }) 0.5

-- ============================================================================
-- 8. User function shadowing a prelude extern (sin, max)
--    User definitions shadow prelude externs in value position.
--    Value-level shadowing is allowed — values are a separate namespace
--    from type-level declarations.

mySin : F32 -> F32
mySin x = x * 0.01

mySinResult : F32
mySinResult = mySin 1.0

-- Prelude sin is shadowed but we can still use arithmetic
preludeSinWorkaround : F32
preludeSinWorkaround = sin 0.5

-- User function shadowing `max`
customMax : F32 -> F32 -> F32
customMax a b = a - b

customMaxResult : F32
customMaxResult = customMax 10.0 3.0

-- ============================================================================
-- 9. User data type with constructor shadowing a prelude constructor (Some)
--    `Some` from prelude Option is shadowed by the user's constructor.
--    Constructors are in the value namespace.

data MaybeVal = Some F32 | None

someVal : MaybeVal
someVal = Some 99.0

-- ============================================================================
-- 10. User data type with constructor shadowing a prelude constructor (Ok)
--     `Ok` from prelude Result is shadowed by the user's constructor.

data Status = Ok I32 | Failed

okStatus : Status
okStatus = Ok 0

-- ============================================================================
-- 11. User type alias (new name, no conflict with prelude)
--     `Color` is a new alias not in the prelude.

alias Color = Vec<3, F32>

bgColor : Color
bgColor = [0.5, 0.5, 0.5]

-- ============================================================================
-- 12. Data type with no type-level name conflict (just a regular type)

data Metric = Metric { value : F32 }

metricValue : Metric -> F32
metricValue m = m.value

metricResult : F32
metricResult = metricValue (Metric { value = 10.0 })

-- ============================================================================
-- 13. Data type with parameterized type

data Container a = Container a

data Tag = Tag I32

tagResult : Tag
tagResult = Tag 42

-- ============================================================================
-- 14. Cross-module: imported names from ConflictsLib
--     The imported module defines value-level names that shadow prelude
--     externs (distance, abs) and new type-level names (Clamp, SignedVal).
--     None of these conflict with prelude type-level names.

import ConflictsLib

-- Uses the imported `distance` function (shadows prelude's vector distance)
crossModuleDistance : F32
crossModuleDistance = distance 10.0 3.0

-- Uses the imported `abs` function (shadows prelude's abs)
crossModuleAbs : F32
crossModuleAbs = abs 5.0

-- Uses the imported `SignedVal` type
crossModuleSigned : SignedVal
crossModuleSigned = SignedVal { amount = -5.0 }