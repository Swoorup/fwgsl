-- ConflictsLib.shadml — Module imported by conflicts.shadml
--
-- Defines names that interact with the prelude. Since type-level names
-- form a unified namespace, no type-level name here may clash with the
-- prelude. Value-level names (functions, constructors) may shadow
-- prelude value bindings.

module ConflictsLib

-- A data type named after a prelude extern (clamp)
-- The prelude has `extern clamp : a -> a -> a -> a`.
-- `Clamp` as a data type is fine — it's a new type-level name.
data Clamp = Clamp { lo : F32, hi : F32 }

-- A function that shadows a prelude extern (distance)
-- The prelude has `extern distance : Vec<n, a> -> Vec<n, a> -> a`.
distance : F32 -> F32 -> F32
distance a b = a - b

-- A function that shadows a prelude extern (abs)
-- The prelude has `extern abs : a -> a`.
abs : F32 -> F32
abs x = x * x

-- A data type that implements the prelude's Add trait
data SignedVal = SignedVal { amount : F32 }

addSignedVal : SignedVal -> F32 -> SignedVal
addSignedVal s f = SignedVal { amount = s.amount + f }