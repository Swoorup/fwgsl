builtin impl Mul Vec3u Vec3u Vec3u where
  (*) = native_binop (*)

builtin impl Mul Vec4u Vec4u Vec4u where
  (*) = native_binop (*)

builtin impl Mul Vec2f F32 Vec2f where
  (*) = native_binop (*)

builtin impl Mul Vec3f F32 Vec3f where
  (*) = native_binop (*)

builtin impl Mul Vec4f F32 Vec4f where
  (*) = native_binop (*)

builtin impl Mul F32 Vec2f Vec2f where
  (*) = native_binop (*)

builtin impl Mul F32 Vec3f Vec3f where
  (*) = native_binop (*)

builtin impl Mul F32 Vec4f Vec4f where
  (*) = native_binop (*)

builtin impl Mul Vec2i I32 Vec2i where
  (*) = native_binop (*)

builtin impl Mul Vec3i I32 Vec3i where
  (*) = native_binop (*)

builtin impl Mul Vec4i I32 Vec4i where
  (*) = native_binop (*)

builtin impl Mul I32 Vec2i Vec2i where
  (*) = native_binop (*)

builtin impl Mul I32 Vec3i Vec3i where
  (*) = native_binop (*)

builtin impl Mul I32 Vec4i Vec4i where
