-- | Integer remainder with the native `%` operator.
builtin impl Mod I32 I32 I32 where
  (%) = native_binop (%)

builtin impl Mod U32 U32 U32 where
  (%) = native_binop (%)

builtin impl Mod Vec2i Vec2i Vec2i where
  (%) = native_binop (%)

builtin impl Mod Vec3i Vec3i Vec3i where
  (%) = native_binop (%)

builtin impl Mod Vec4i Vec4i Vec4i where
  (%) = native_binop (%)

builtin impl Mod Vec2u Vec2u Vec2u where
