-- prelude.shadml — Built-in type signatures for shadml
--
-- These declarations define the type environment. They are not compiled to WGSL.
-- User definitions shadow prelude names.

-- Builtin scalar and shaped type constructors.
--
-- These names are compiler-recognized, but they are declared here so IDE
-- features can treat the prelude as the source of truth.

-- | Signed 32-bit integer scalar.
builtin type I32
-- | Unsigned 32-bit integer scalar.
builtin type U32
-- | 32-bit floating point scalar.
builtin type F32
-- | Boolean scalar.
builtin type Bool
-- | Source-level string type.
builtin type String
-- | Fixed-length vector type constructor with dimension and element type.
builtin type Vec 2
-- | Long-form alias for `Vec`.
builtin type Vector 2
-- | Matrix type constructor with row count, column count, and element type.
builtin type Mat 3
-- | Long-form alias for `Mat`.
builtin type Matrix 3
-- | Tensor/array type constructor with extent and element type.
builtin type Tensor 2
-- | Surface alias for tensor/array shapes.
builtin type Array 2
-- | Short alias for `Tensor`.
builtin type Ten 2
-- | Scalar wrapper alias.
builtin type Scalar 1
-- | Short alias for `Scalar`.
builtin type Sca 1

-- Texture & sampler types (opaque resource types)
-- | 2D texture with element type parameter (e.g. Texture2d F32 → texture_2d<f32>).
builtin type Texture2d 1
-- | Multisampled 2D texture with element type parameter.
builtin type Texture2dMultisampled 1
-- | 2D texture array with element type parameter.
builtin type Texture2dArray 1
-- | Sampler type (filtering).
builtin type Sampler 0
-- | Comparison sampler type.
builtin type SamplerComparison 0
-- | Runtime-sized binding array with element type and count parameters.
builtin type BindingArray 2

-- Data types

-- | Optional value.
data Option a = Some a | None
-- | Success-or-error result.
data Result a = Ok a | Err String
-- | Builtin product type.
data Pair a b = Pair a b

-- Operator overloading traits
--
-- Concrete builtin operator support is declared below through `builtin impl`
-- entries. Users can write ordinary `impl` blocks for their own types.

trait Add a b where
  type Output
  (+) : a -> b -> Self.Output

trait Sub a b where
  type Output
  (-) : a -> b -> Self.Output

trait Mul a b where
  type Output
  (*) : a -> b -> Self.Output

trait Div a b where
  type Output
  (/) : a -> b -> Self.Output

trait Mod a b where
  type Output
  (%) : a -> b -> Self.Output

trait BitAnd a b where
  type Output
  (&) : a -> b -> Self.Output

trait BitXor a b where
  type Output
  (^) : a -> b -> Self.Output

trait Shl a b where
  type Output
  (<<) : a -> b -> Self.Output

trait Shr a b where
  type Output
  (>>) : a -> b -> Self.Output

trait BitNot a where
  (~) : a -> a

trait Neg a where
  (-) : a -> a

alias Vec2f = Vec<2, F32>
alias Vec3f = Vec<3, F32>
alias Vec4f = Vec<4, F32>
alias Vec2i = Vec<2, I32>
alias Vec3i = Vec<3, I32>
alias Vec4i = Vec<4, I32>
alias Vec2u = Vec<2, U32>
alias Vec3u = Vec<3, U32>
alias Vec4u = Vec<4, U32>

-- Comparison and boolean operators remain ordinary externs because they do not
-- dispatch through the operator-trait system yet.

extern (==) : a -> a -> Bool
extern (/=) : a -> a -> Bool
extern (<)  : a -> a -> Bool
extern (>)  : a -> a -> Bool
extern (<=) : a -> a -> Bool
extern (>=) : a -> a -> Bool

extern (&&) : Bool -> Bool -> Bool
extern (||) : Bool -> Bool -> Bool

-- `bor` remains a direct builtin because `|` is reserved for pattern syntax.
extern bor : a -> a -> a

-- | Add two f32 scalars with the native `+` operator.
builtin impl Add F32 F32 where
  type Output = F32
  (+) = native_binop (+)

builtin impl Add I32 I32 where
  type Output = I32
  (+) = native_binop (+)

builtin impl Add U32 U32 where
  type Output = U32
  (+) = native_binop (+)

builtin impl Add Vec2f Vec2f where
  type Output = Vec2f
  (+) = native_binop (+)

builtin impl Add Vec3f Vec3f where
  type Output = Vec3f
  (+) = native_binop (+)

builtin impl Add Vec4f Vec4f where
  type Output = Vec4f
  (+) = native_binop (+)

builtin impl Add Vec2i Vec2i where
  type Output = Vec2i
  (+) = native_binop (+)

builtin impl Add Vec3i Vec3i where
  type Output = Vec3i
  (+) = native_binop (+)

builtin impl Add Vec4i Vec4i where
  type Output = Vec4i
  (+) = native_binop (+)

builtin impl Add Vec2u Vec2u where
  type Output = Vec2u
  (+) = native_binop (+)

builtin impl Add Vec3u Vec3u where
  type Output = Vec3u
  (+) = native_binop (+)

builtin impl Add Vec4u Vec4u where
  type Output = Vec4u
  (+) = native_binop (+)

