  (^) = native_binop (^)

builtin impl BitXor Vec4u Vec4u Vec4u where
  (^) = native_binop (^)

-- | Shift-left with the native `<<` operator.
builtin impl Shl I32 I32 I32 where
  (<<) = native_binop (<<)

builtin impl Shl I32 U32 I32 where
  (<<) = native_binop (<<)

builtin impl Shl U32 I32 U32 where
  (<<) = native_binop (<<)

builtin impl Shl U32 U32 U32 where
  (<<) = native_binop (<<)

-- | Shift-right with the native `>>` operator.
builtin impl Shr I32 I32 I32 where
  (>>) = native_binop (>>)

builtin impl Shr I32 U32 I32 where
  (>>) = native_binop (>>)

builtin impl Shr U32 I32 U32 where
  (>>) = native_binop (>>)

builtin impl Shr U32 U32 U32 where
  (>>) = native_binop (>>)

-- | Unary numeric negation with the native `-` operator.
builtin impl Neg F32 where
  (-) = native_unary (-)

builtin impl Neg I32 where
  (-) = native_unary (-)

builtin impl Neg Vec2f where
  (-) = native_unary (-)

builtin impl Neg Vec3f where
  (-) = native_unary (-)

builtin impl Neg Vec4f where
  (-) = native_unary (-)

builtin impl Neg Vec2i where
  (-) = native_unary (-)

builtin impl Neg Vec3i where
  (-) = native_unary (-)

builtin impl Neg Vec4i where
  (-) = native_unary (-)

-- | Bitwise complement with the native `~` operator.
builtin impl BitNot I32 where
  (~) = native_unary (~)

builtin impl BitNot U32 where
  (~) = native_unary (~)

builtin impl BitNot Vec2i where
  (~) = native_unary (~)

builtin impl BitNot Vec3i where
  (~) = native_unary (~)

builtin impl BitNot Vec4i where
  (~) = native_unary (~)

builtin impl BitNot Vec2u where
  (~) = native_unary (~)

