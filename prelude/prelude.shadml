  (&) = native_binop (&)

builtin impl BitAnd Vec4u Vec4u Vec4u where
  (&) = native_binop (&)

-- | Bitwise xor with the native `^` operator.
builtin impl BitXor I32 I32 I32 where
  (^) = native_binop (^)

builtin impl BitXor U32 U32 U32 where
  (^) = native_binop (^)

builtin impl BitXor Vec2i Vec2i Vec2i where
  (^) = native_binop (^)

builtin impl BitXor Vec3i Vec3i Vec3i where
  (^) = native_binop (^)

builtin impl BitXor Vec4i Vec4i Vec4i where
