-- prelude.shadml — Built-in type signatures for shadml
--
-- These declarations define the type environment. They are not compiled to WGSL.
-- User definitions shadow prelude names.

-- Data types

data Option a = Some a | None
data Result a = Ok a | Err String
data Pair a b = Pair a b

-- Operator overloading traits
--
-- Concrete builtin operator support is declared below through `builtin impl`
-- entries. Users can write ordinary `impl` blocks for their own types.

trait Add a b c where
  (+) : a -> b -> c

trait Sub a b c where
  (-) : a -> b -> c

trait Mul a b c where
  (*) : a -> b -> c

trait Div a b c where
  (/) : a -> b -> c

trait Mod a b c where
  (%) : a -> b -> c

trait BitAnd a b c where
  (&) : a -> b -> c

trait BitXor a b c where
  (^) : a -> b -> c

trait Shl a b c where
  (<<) : a -> b -> c

trait Shr a b c where
  (>>) : a -> b -> c

trait BitNot a where
  (~) : a -> a

trait Neg a where
  (-) : a -> a

alias Vec2f = Vec<2, F32>
alias Vec3f = Vec<3, F32>
alias Vec4f = Vec<4, F32>
alias Vec2i = Vec<2, I32>
alias Vec3i = Vec<3, I32>
alias Vec4i = Vec<4, I32>
alias Vec2u = Vec<2, U32>
alias Vec3u = Vec<3, U32>
alias Vec4u = Vec<4, U32>

-- Comparison and boolean operators remain ordinary externs because they do not
-- dispatch through the operator-trait system yet.

extern (==) : a -> a -> Bool
extern (/=) : a -> a -> Bool
extern (<)  : a -> a -> Bool
extern (>)  : a -> a -> Bool
extern (<=) : a -> a -> Bool
extern (>=) : a -> a -> Bool

extern (&&) : Bool -> Bool -> Bool
extern (||) : Bool -> Bool -> Bool

-- `bor` remains a direct builtin because `|` is reserved for pattern syntax.
extern bor : a -> a -> a

-- | Add two f32 scalars with the native `+` operator.
builtin impl Add F32 F32 F32 where
  (+) = native_binop (+)

builtin impl Add I32 I32 I32 where
  (+) = native_binop (+)

builtin impl Add U32 U32 U32 where
  (+) = native_binop (+)

builtin impl Add Vec2f Vec2f Vec2f where
  (+) = native_binop (+)

builtin impl Add Vec3f Vec3f Vec3f where
  (+) = native_binop (+)

builtin impl Add Vec4f Vec4f Vec4f where
  (+) = native_binop (+)

builtin impl Add Vec2i Vec2i Vec2i where
  (+) = native_binop (+)

builtin impl Add Vec3i Vec3i Vec3i where
  (+) = native_binop (+)

builtin impl Add Vec4i Vec4i Vec4i where
  (+) = native_binop (+)

builtin impl Add Vec2u Vec2u Vec2u where
  (+) = native_binop (+)

builtin impl Add Vec3u Vec3u Vec3u where
  (+) = native_binop (+)

builtin impl Add Vec4u Vec4u Vec4u where
  (+) = native_binop (+)

-- | Subtract values with the native `-` operator.
builtin impl Sub F32 F32 F32 where
  (-) = native_binop (-)

builtin impl Sub I32 I32 I32 where
  (-) = native_binop (-)

builtin impl Sub U32 U32 U32 where
  (-) = native_binop (-)

builtin impl Sub Vec2f Vec2f Vec2f where
  (-) = native_binop (-)

builtin impl Sub Vec3f Vec3f Vec3f where
  (-) = native_binop (-)

builtin impl Sub Vec4f Vec4f Vec4f where
  (-) = native_binop (-)

builtin impl Sub Vec2i Vec2i Vec2i where
  (-) = native_binop (-)

builtin impl Sub Vec3i Vec3i Vec3i where
  (-) = native_binop (-)

builtin impl Sub Vec4i Vec4i Vec4i where
  (-) = native_binop (-)

builtin impl Sub Vec2u Vec2u Vec2u where
  (-) = native_binop (-)

builtin impl Sub Vec3u Vec3u Vec3u where
  (-) = native_binop (-)

builtin impl Sub Vec4u Vec4u Vec4u where
  (-) = native_binop (-)

