-- | Divide values with the native `/` operator.
builtin impl Div F32 F32 F32 where
  (/) = native_binop (/)

builtin impl Div I32 I32 I32 where
  (/) = native_binop (/)

builtin impl Div U32 U32 U32 where
  (/) = native_binop (/)

builtin impl Div Vec2f Vec2f Vec2f where
