builtin impl Mod Vec3u Vec3u Vec3u where
  (%) = native_binop (%)

builtin impl Mod Vec4u Vec4u Vec4u where
  (%) = native_binop (%)

-- | Bitwise and with the native `&` operator.
builtin impl BitAnd I32 I32 I32 where
  (&) = native_binop (&)

builtin impl BitAnd U32 U32 U32 where
  (&) = native_binop (&)

builtin impl BitAnd Vec2i Vec2i Vec2i where
  (&) = native_binop (&)

builtin impl BitAnd Vec3i Vec3i Vec3i where
  (&) = native_binop (&)

builtin impl BitAnd Vec4i Vec4i Vec4i where
